# Rovik configuration template — copy to `rovik.env` or generate via `rovik init`.
# `rovik.env` is gitignored. Never put raw API keys in files tracked by git.

# --- Local Tier (Tier 1: fast/free local inference) ---
# Reference Apple Silicon Qwen3.6-35B-A3B llama-server runs on 127.0.0.1:8082.
ROVIK_LOCAL_URL=http://127.0.0.1:8082/v1/chat/completions
ROVIK_LOCAL_MODEL=local-35b
ROVIK_TAG_LOCAL="[🟢 LOCAL · 35B-A3B]"

# --- Frontier Tier (Tier 2: selective escalation) ---
# Keep API keys in your shell environment or in ROVIK_ENV_FILE, never here.
ROVIK_ESC_URL=https://openrouter.ai/api/v1/chat/completions
ROVIK_ESC_MODEL=z-ai/glm-5.3
ROVIK_ESC_KEYNAME=OPENROUTER_API_KEY
ROVIK_ENV_FILE=~/.hermes/.env
ROVIK_FRONTIER_PRICE_PER_MTOK=3.0
ROVIK_TAG_ESC="[⚡ ESCALATED · GLM 5.3]"

# --- Labeling Teacher (training-time only; >=30B local or frontier API) ---
ROVIK_TEACHER_URL=http://127.0.0.1:8082/v1/chat/completions
ROVIK_TEACHER_MODEL=local-35b
ROVIK_TEACHER_KEYNAME=

# --- Corpus & Laya Decision Sidecar ---
ROVIK_CORPUS_PATH=
LAYA_MODEL_PATH=checkpoints/cold-test
LAYA_SIDECAR_HOST=127.0.0.1
LAYA_SIDECAR_PORT=8777
LAYA_SIDECAR_URL=http://127.0.0.1:8777/predict
LAYA_CLEAR_CACHE_EVERY=10
LAYA_THRESH_HARD=0.8
LAYA_THRESH_TOOLS=0.5
LAYA_THRESH_VERIFY=0.5

# --- Proxy & Logging ---
ROVIK_PROXY_HOST=127.0.0.1
ROVIK_PROXY_PORT=8788
ROVIK_JUDGE_URL=http://127.0.0.1:8777/predict
ROVIK_FALLBACK_ROUTE=local
ROVIK_LOG_DIR=data
